# dwoe-base:latest
#
# Carries both Anthropic and OpenAI agent CLIs.
# The images are provider-agnostic: the same image runs Claude Code or Codex depending on AGENT_PROVIDER.
# Language images add their toolchain on top of this one.
# Trixie is used for its modern GCC.
#
# Build:
# docker build -f docker/Dockerfile.base -t dwoe-base:latest docker/
#
FROM debian:trixie-slim

ARG USER_ID=9999
ARG GROUP_ID=9999

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    curl \
    jq \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g ${GROUP_ID} agent && \
    useradd -m -u ${USER_ID} -g agent -s /bin/bash agent

RUN mkdir -p /workspace /logs && \
    chown -R agent:agent /workspace /logs

USER agent
WORKDIR /workspace

ENV PATH="/home/agent/.local/bin:${PATH}"

# Claude Code CLI
RUN curl -fsSL https://claude.ai/install.sh | bash

# OpenAI Codex CLI (standalone binary, no Node required)
RUN curl -fsSL https://chatgpt.com/codex/install.sh | CODEX_NON_INTERACTIVE=1 sh

RUN mkdir -p /home/agent/.claude /home/agent/.codex

COPY entrypoint.sh /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
